# Archivos generados por skills
docs/validacion-*.md
docs/test_results.json
docs/screenshot_*.png
docs/preview-componentes-screenshot*.png
docs/*.html

# Archivos comprimidos
*.rar
Ateje-Stack-Portable.zip

# Estado local de herramientas
.omd/
.opencode/tmp/
tests/test_results.json
skills.rar

# Dependencias de MCP servers
mcp-servers/*/node_modules/
mcp-servers/*/dist/

# Backup zip
opencode-backup-*.zip

# Backup de config local (contiene tokens)
_backup-config/

# Archivos bak
*.bak

# Directorios vacios
**/img/

# License system - private key (never version)
keys/private.pem

# License system - generated output
licencias/

# Cache de tests
__pycache__/
.pytest_cache/
tests/__pycache__/
tests/.pytest_cache

# Generated by Ateje Stack
dist/
tools/
specs/
wiki/
modules/
white-label/
tests/*.pyz/

# IA Jutia plugin templates are source, not generated
!ia-jutia/templates/plugin/tools/
!ia-jutia/templates/plugin/tools/*.js
