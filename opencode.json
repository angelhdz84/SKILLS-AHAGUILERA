{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["."]
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "prompt": "{file:.opencode/prompts/orchestrator.md}",
      "description": "Orquestador maestro del pipeline offline-first",
      "permission": { "edit": "ask", "bash": "ask" }
    },
    "build-agent": {
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/build-agent.md}",
      "description": "Genera codigo desde specs usando code-generator + compliance guard",
      "permission": { "edit": "allow", "bash": "ask" }
    },
    "design-agent": {
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/design-agent.md}",
      "description": "Aplica brand context injection con design-engine",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "spec-agent": {
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/spec-agent.md}",
      "description": "Crea specs tecnicas + DESIGN.md usando spec-engine",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "test-agent": {
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/test-agent.md}",
      "description": "Valida apps con validation-engine 4 fases + refactor",
      "permission": { "edit": "ask", "bash": "ask" }
    }
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["C:\\Users\\Angel\\bin\\engram.exe", "mcp", "--project", "Ateje"],
      "environment": { "ENGRAM_DATA_DIR": "D:\\REPOSITORIOS GitHUB\\Ateje\\.omd" },
      "description": "Memoria persistente del agente. Requiere Engram instalado"
    }
  },
  "instructions": ["AGENTS.md"]
}
